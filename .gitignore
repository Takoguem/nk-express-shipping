# Référence : https://help.github.com/articles/ignoring-files/

# Dépendances
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Tests
/coverage

# Anciens caches de construction, non publiés
/.next/
/.vinext/
/out/

# Fichiers divers
.DS_Store
*.pem

# Journaux de débogage
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Variables d'environnement locales
.env*

# Vercel
.vercel

/dist/
/.wrangler/
/outputs/
/work/
